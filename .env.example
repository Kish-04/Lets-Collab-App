# Frontend configuration
NEXT_PUBLIC_BACKEND_URL=http://localhost:8081
NEXT_PUBLIC_BACKEND_PORT=8081
NEXT_PUBLIC_DESKTOP_DOWNLOAD_URL=/downloads/Lets-Collab-Cloud-Setup.exe

# Used by Next.js rewrites during local development/builds.
BACKEND_URL=http://localhost:8081

# Used by Electron to load the web UI.
APP_URL=http://127.0.0.1:3000
# Used by installed Electron builds to reach the hosted backend.
LETSCOLLAB_BACKEND_URL=http://localhost:8081

# Exam "Run code" runs code on the web server with no sandbox. On by default only in development;
# set to true in production only on an isolated host. Callers must be signed in either way.
CODE_EXECUTION_ENABLED=

# Server
NODE_ENV=development
PORT=8081

# Database
MONGO_URI=mongodb://127.0.0.1:27017/ircp_db
MONGO_CONNECT_TIMEOUT_MS=5000

# Security
# Use a long random value in production, for example: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-characters
# Keys the HMAC that pseudonymises emails on the audit chain. Keep it stable once set.
AUDIT_HASH_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30d
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Bootstrap admin account. The account is created on first successful login if it does not exist.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# EmailJS OTP delivery. For production, set these on the backend host.
# EMAILJS_PRIVATE_KEY is optional but recommended when EmailJS API access restrictions require it.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Optional Resend fallback. If no email provider is configured, OTP can still be logged in development.
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev
LOG_OTP=true

# Blockchain / Hardhat
RPC_URL=http://127.0.0.1:8545
PRIVATE_KEY=
# Audit ledger on Polygon/any EVM chain (see server/.env.example)
CHAIN_RPC_URL=
CHAIN_PRIVATE_KEY=
CONTRACT_ADDRESS=
NEXT_PUBLIC_CHAIN_EXPLORER_TX_URL=https://sepolia.etherscan.io/tx/
# Differential privacy for federated learning (lib/dpAccountant.ts): Gaussian noise multiplier on the
# aggregate (0 disables), the epsilon budget per exam session on a device, and how many devices share the
# noise (keep equal to the server FL_MIN_PARTICIPANTS). Defaults: 1, 10, 3 -> up to 3 rounds per session.
NEXT_PUBLIC_FL_DP_NOISE=1
NEXT_PUBLIC_FL_EPSILON_BUDGET=10
NEXT_PUBLIC_FL_MIN_PARTICIPANTS=3
ALLOW_MOCK_BLOCKCHAIN=true

# WebRTC (TURN servers for production reliability)
NEXT_PUBLIC_FORCE_TURN=false
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
# Backend TURN fleet with short-lived credentials (see server/.env.example)
TURN_URLS=
TURN_SECRET=
TURN_CREDENTIAL_TTL=43200
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
METERED_DOMAIN=
METERED_SECRET_KEY=

# Development fallback store. Do not commit the generated JSON file.
MOCK_STORE_FILE=mock_data.json
