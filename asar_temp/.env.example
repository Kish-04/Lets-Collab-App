# Frontend configuration
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_BACKEND_PORT=3001

# Used by Next.js rewrites during local development/builds.
BACKEND_URL=http://localhost:3001

# Used by Electron to load the web UI.
APP_URL=http://127.0.0.1:3000

# Server
NODE_ENV=development
PORT=3001

# Database
MONGO_URI=mongodb://127.0.0.1:27017/ircp_db
MONGO_CONNECT_TIMEOUT_MS=5000

# Security
# Use a long random value in production, for example: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-characters
JWT_EXPIRES_IN=30d
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Bootstrap admin account. The account is created on first successful login if it does not exist.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Email delivery. If RESEND_API_KEY is empty, OTP can still be logged in development.
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev
LOG_OTP=true

# Blockchain / Hardhat
RPC_URL=http://127.0.0.1:8545
PRIVATE_KEY=
ALLOW_MOCK_BLOCKCHAIN=true

# WebRTC (TURN servers for production reliability)
NEXT_PUBLIC_FORCE_TURN=false
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
METERED_DOMAIN=
METERED_SECRET_KEY=

# Development fallback store. Do not commit the generated JSON file.
MOCK_STORE_FILE=mock_data.json

# EmailJS (Frontend)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
