FROM node:22

WORKDIR /app/server

# Copy package.json to leverage Docker cache
COPY server/package.json server/package-lock.json* ./

# Install dependencies at build time
RUN npm install

# Copy application source
COPY server/ .

EXPOSE 3001
EXPOSE 8545

# Default command for backend (can be overridden by compose for hardhat)
CMD ["npm", "run", "dev"]
