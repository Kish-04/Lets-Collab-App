{
  "name": "lets-collab",
  "version": "0.1.9",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "next dev",
    "server": "node server/index.js",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "lint": "eslint app components hooks lib main.js preload.js \"server/*.js\" \"server/test/*.js\" \"test/*.js\" \"test/*.mjs\"",
    "electron:dev": "electron .",
    "prebuild:electron": "npm run build",
    "build:electron": "electron-builder",
    "prebuild:win": "npm run build",
    "build:win": "electron-builder --win nsis",
    "prebuild:mac": "npm run build",
    "build:mac": "electron-builder --mac zip",
    "prebuild:linux": "npm run build",
    "build:linux": "electron-builder --linux tar.gz deb",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.letscollab.app",
    "productName": "Let's Collab",
    "extraResources": [
      {
        "from": "build/ViGEmBusSetup_x64.msi",
        "to": "ViGEmBusSetup_x64.msi"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "compression": "normal",
    "asar": true,
    "asarUnpack": [
      "mkcert.exe",
      "**/*.node"
    ],
    "files": [
      "**/*",
      "!server/**/*",
      "!test",
      "!scratch/**/*",
      "!asar_temp/**/*",
      "!dist",
      "!.next",
      "!.git",
      "!chrome",
      "!out/downloads",
      "!public/downloads",
      "!*.log",
      "!*.txt",
      "!capture_error.js",
      "!check-repo.js",
      "!e2e_audit.js",
      "!test-*.js",
      "!test_*.js",
      "!test_*.ts",
      "!fix*.js",
      "!patch*.js",
      "!modify.js",
      "!inject-sidebar.js"
    ],
    "mac": {
      "target": [
        "zip"
      ],
      "icon": "public/logo.ico"
    },
    "win": {
      "target": "nsis",
      "icon": "public/logo.ico"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Let's Collab"
    },
    "linux": {
      "category": "Utility",
      "target": [
        "tar.gz",
        "deb"
      ],
      "executableName": "lets-collab"
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@hookform/resolvers": "^3.9.1",
    "@mediapipe/tasks-vision": "^0.10.32",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-aspect-ratio": "1.1.8",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-context-menu": "2.2.16",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-hover-card": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-menubar": "1.1.16",
    "@radix-ui/react-navigation-menu": "1.2.14",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-toast": "1.2.15",
    "@radix-ui/react-toggle": "1.1.10",
    "@radix-ui/react-toggle-group": "1.1.11",
    "@radix-ui/react-tooltip": "1.2.8",
    "@tailwindcss/postcss": "^4.2.0",
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@types/node": "^22",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vercel/analytics": "1.6.1",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "4.1.0",
    "electron": "^32.3.3",
    "electron-builder": "^26.15.3",
    "embla-carousel-react": "8.6.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.1.6",
    "input-otp": "1.4.2",
    "lucide-react": "^0.564.0",
    "mongoose": "^9.7.4",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "postcss": "^8.5",
    "puppeteer": "^25.3.0",
    "react": "19.2.4",
    "react-day-picker": "9.13.2",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.54.1",
    "react-resizable-panels": "^2.1.7",
    "recharts": "2.15.0",
    "socket.io-client": "^4.8.3",
    "sonner": "^1.7.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "1.3.3",
    "typescript": "5.7.3",
    "vaul": "^1.1.2",
    "zod": "^3.24.1"
  },
  "homepage": "https://letscollab.com",
  "author": {
    "name": "Admin",
    "email": "admin@letscollab.com"
  },
  "dependencies": {
    "@mediapipe/camera_utils": "^0.3.1675466862",
    "@mediapipe/selfie_segmentation": "^0.1.1675465747",
    "@vladmandic/face-api": "^1.7.15",
    "express": "^5.2.1",
    "framer-motion": "^12.42.2"
  },
  "optionalDependencies": {
    "robotjs": "^0.7.1",
    "vigemclient": "^1.5.3"
  }
}
