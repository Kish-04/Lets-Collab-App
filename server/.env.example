# Server
NODE_ENV=development
PORT=8081

# Database
MONGO_URI=mongodb://127.0.0.1:27017/ircp_db
MONGO_CONNECT_TIMEOUT_MS=5000

# Security
# Use a long random value in production, for example: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-characters
# Keys the HMAC that pseudonymises emails on the audit chain. Keep it stable once set.
AUDIT_HASH_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30d
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Bootstrap admin account. The account is created on first successful login if it does not exist.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# EmailJS OTP delivery. For production, set these on the backend host.
# EMAILJS_PRIVATE_KEY is optional but recommended when EmailJS API access restrictions require it.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Optional Resend fallback. If no email provider is configured, OTP can still be logged in development.
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev
LOG_OTP=true

# Blockchain / Hardhat
RPC_URL=http://127.0.0.1:8545
PRIVATE_KEY=
# Production audit ledger on any EVM chain (recommended: Polygon PoS, chainId 137; rehearse on Amoy, 80002).
# CHAIN_* take precedence over RPC_URL/PRIVATE_KEY/SEPOLIA_*.
CHAIN_RPC_URL=
CHAIN_PRIVATE_KEY=
CONTRACT_ADDRESS=
CONTRACT_DEPLOY_BLOCK=
# Optional overrides: priority-fee floor (Polygon default 30 gwei), explorer, eth_getLogs chunking
CHAIN_MIN_PRIORITY_FEE_GWEI=
CHAIN_EXPLORER_URL=
CHAIN_LOG_BLOCK_RANGE=10000
# Deployment (npm run deploy:amoy / deploy:polygon)
DEPLOYER_PRIVATE_KEY=
AMOY_RPC_URL=
POLYGON_RPC_URL=
AUDIT_WRITER_ADDRESS=
ETHERSCAN_API_KEY=
# Secure aggregation rounds for federated learning
FL_MIN_PARTICIPANTS=3
FL_ROUND_INTERVAL_MS=300000
ALLOW_MOCK_BLOCKCHAIN=true

# WebRTC TURN (preferred): self-hosted coturn fleet with short-lived credentials.
# List every regional node; all must share TURN_SECRET (coturn static-auth-secret).
# e.g. TURN_URLS=turn:turn-eu.example.com:3478?transport=udp,turns:turn-eu.example.com:5349?transport=tcp,turn:turn-us.example.com:3478?transport=udp
TURN_URLS=
TURN_SECRET=
TURN_CREDENTIAL_TTL=43200
STUN_URLS=
# Alternatives: static TURN credentials or Metered TURN credentials.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
METERED_DOMAIN=
METERED_SECRET_KEY=

# Development fallback store. Do not commit the generated JSON file.
MOCK_STORE_FILE=

# On-chain anchoring budget (each anchor is a paid transaction). Session archive/termination and
# panic revokes are always anchored; other events past these limits are kept off-chain only.
CHAIN_MAX_TX_PER_ROOM=40
CHAIN_MAX_TX_PER_MINUTE=120
CHAIN_NOISY_INTERVAL_MS=20000
MAX_ROOMS_PER_USER_PER_10_MIN=10

# How long a dropped host (room held) or controller (approval kept) may take to reconnect; 0 disables
HOST_RECONNECT_GRACE_MS=45000
CONTROLLER_RECONNECT_GRACE_MS=45000

# Ed25519 key that signs the hash-linked audit chain (server/auditChain.js). Keep it stable and secret;
# without it a temporary key is used and older sessions cannot be re-verified after a restart. Generate:
#   node -e "console.log(require('crypto').generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'pem'}).replace(/
/g,'\n'))"
AUDIT_SIGNING_KEY=
